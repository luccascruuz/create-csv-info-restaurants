# Copie para .env:  cp .env.example .env
# Tudo aqui é opcional: os padrões já funcionam SEM CUSTO (OpenStreetMap + Ollama/template).
# Opções passadas na linha de comando têm prioridade sobre este arquivo.

# ── Localização ─────────────────────────────────────────────
# Use a cidade (geocoding grátis) OU as coordenadas
SEARCH_CITY=Lagarto, SE
# SEARCH_LAT=-10.91722
# SEARCH_LNG=-37.65
SEARCH_RADIUS=10000
MAX_RESULTS=20

# ── Fonte dos dados ─────────────────────────────────────────
# osm    = OpenStreetMap, grátis e sem chave (padrão)
# google = Google Places API (New), PAGO, exige GOOGLE_MAPS_API_KEY
PLACES_SOURCE=osm
# Tipos do OSM: restaurant, fast_food, cafe, bar, pub, ice_cream
OSM_AMENITIES=restaurant,fast_food
# Servidor Overpass próprio (opcional)
# OVERPASS_URL=
# Termo de busca (só google)
# SEARCH_QUERY=restaurantes
# GOOGLE_MAPS_API_KEY=

# ── Geração das mensagens ───────────────────────────────────
# auto     = ollama se estiver rodando, senão template (padrão, grátis)
# template = textos prontos, sem IA (grátis, offline)
# ollama   = IA local (grátis) - https://ollama.com
# gemini   = Google Gemini, camada gratuita (exige GEMINI_API_KEY)
# openai   = PAGO (exige OPENAI_API_KEY)
LLM_PROVIDER=auto
# Padrões: ollama=gemma3:4b, gemini=gemini-2.5-flash, openai=gpt-5-mini
# LLM_MODEL=
# OLLAMA_URL=http://localhost:11434/v1
# Modelo do Ollama (vale só para o Ollama; padrão gemma3:4b). Com 16 GB+ de RAM, gemma3:12b escreve melhor.
# OLLAMA_MODEL=gemma3:12b
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# CONCURRENCY=

# ── Assinatura ──────────────────────────────────────────────
COMPANY_NAME=MagicMarketing
# Vazio = assina como "Equipe <empresa>"
SENDER_NAME=
SENDER_ROLE=

# ── Saída ───────────────────────────────────────────────────
# csv | xlsx | ambos
OUTPUT_FORMAT=ambos
# Caminho sem extensão
OUTPUT_FILE=output/restaurantes
