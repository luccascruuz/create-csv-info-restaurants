{
  "name": "create-csv-restaurant",
  "version": "3.0.0",
  "description": "Busca restaurantes no Google Places e gera mensagens de prospecção personalizadas com OpenAI, exportando para CSV.",
  "type": "module",
  "main": "src/cli.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "exceljs": "^4.4.0",
    "openai": "^7.52.0",
    "p-limit": "^7.3.3",
    "p-retry": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
